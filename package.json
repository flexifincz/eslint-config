{
  "name": "@flexifin/eslint-config",
  "version": "2.5.21",
  "description": "Code service level repo for sharing common sources through several FF projects.",
  "repository": "flexifincz/eslint-config",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/eslint.d.mts",
      "import": "./dist/eslint.mjs"
    },
    "./prettier": {
      "types": "./dist/prettier.d.mts",
      "import": "./dist/prettier.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "eslint-config-inspector",
    "lint:check": "eslint . && prettier --check .",
    "lint:fix": "automd && eslint . --fix && prettier --write .",
    "prepack": "pnpm build",
    "types:check": "tsc --noEmit --skipLibCheck",
    "test": "pnpm lint:check && pnpm types:check"
  },
  "dependencies": {
    "@darraghor/eslint-plugin-nestjs-typed": "^7.1.32",
    "@eslint-react/eslint-plugin": "^5.7.7",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.6",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tanstack/eslint-plugin-query": "^5.100.10",
    "@vitest/eslint-plugin": "^1.6.17",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-case-police": "^2.2.1",
    "eslint-plugin-i18next": "^6.1.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-playwright": "^2.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-storybook": "^10.4.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.6.0",
    "typescript-eslint": "^8.59.3"
  },
  "devDependencies": {
    "@eslint/config-inspector": "^1.5.0",
    "@types/eslint": "^9.6.1",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^25.7.0",
    "automd": "^0.4.3",
    "changelogen": "^0.6.2",
    "eslint": "^10.3.0",
    "eslint-typegen": "^2.3.1",
    "jiti": "^2.7.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1"
  },
  "peerDependencies": {
    "eslint": "*",
    "prettier": "*",
    "typescript": "*"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "neverBuiltDependencies": [],
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-jsx-a11y>eslint": "10",
        "eslint-plugin-storybook>storybook": ">=10.3.5"
      },
      "ignoreMissing": [
        "class-validator"
      ]
    }
  }
}
